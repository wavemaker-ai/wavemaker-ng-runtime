{
    "compileOnSave": false,
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        // TypeScript 6.0: "strict" now defaults to true unless explicitly disabled (previously
        // defaulted to false) - this codebase was never written to satisfy strictNullChecks/
        // noImplicitAny/etc. Pinned back to the pre-6.0 default to preserve existing behavior;
        // a real strict-mode migration is a separate, deliberate effort out of scope here.
        "strict": false,
        "baseUrl": "./",
        "downlevelIteration": true,
        "outDir": "./dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "es2022",
            "dom"
        ],
        "paths": {
            "rxjs/observable/throw": [
                "node_modules/rxjs-compat/_esm2015/observable/throw"
            ],
            "rxjs/observable/*": [
                "node_modules/rxjs-compat/_esm2015/observable/*"
            ],
            "rxjs/Observable": [
                "node_modules/rxjs-compat/_esm2015/Observable"
            ],
            "@wm/build-task": [
                "libraries/build-task/"
            ],
            "@wm/core": [
                "libraries/core"
            ],
            "@wavemaker/variables": [
                "node_modules/@wavemaker/variables/index"
            ],
            "@wavemaker/custom-widgets-m3": [
                "node_modules/@wavemaker/custom-widgets-m3/index"
            ],
            "@wm/components/base": [
                "libraries/components/base"
            ],
            "@wm/components/basic/*": [
                "libraries/components/basic/*"
            ],
            "@wm/components/input/*": [
                "libraries/components/input/*"
            ],
            "@wm/components/page": [
                "libraries/components/page/default"
            ],
            "@wm/components/dialogs": [
                "libraries/components/dialogs/default"
            ],
            "@wm/components/*": [
                "libraries/components/*"
            ],
            "@wm/transpiler": [
                "libraries/transpiler"
            ],
            "@wm/security": [
                "libraries/security"
            ],
            "@swipey": [
                "libraries/swipey"
            ],
            "@wm/http": [
                "libraries/http"
            ],
            "@wm/oAuth": [
                "libraries/oAuth"
            ],
            "@wm/variables": [
                "libraries/variables"
            ],
            "@wm/runtime/base": [
                "libraries/runtime/base"
            ],
            "@wm/runtime/dynamic": [
                "libraries/runtime/dynamic"
            ]
        },
        "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
        "compilationMode": "full",
        "strictMetadataEmit": false,
        "fullTemplateTypeCheck": false,
        // Angular 22: the legacy fullTemplateTypeCheck:false no longer fully suppresses template
        // property-access checking on its own — strictTemplates now needs its own explicit false
        // to preserve the same pre-22 leniency (this codebase assigns many widget properties, e.g.
        // iconwidth/iconheight/iconmargin, dynamically via registerProps()/PROP_STRING outside
        // TypeScript's static knowledge, and was never written to satisfy strict template checking).
        "strictTemplates": false
    }
}
