# Copy to .env in this folder (sync loads scripts/docsflow-sync/.env automatically).
# Do not commit .env — it is listed in scripts/docsflow-sync/.gitignore
#
# GitLab CI: set DOCSFLOW_MCP_API_KEY or MCP_TOKEN as a masked CI/CD variable — no .env in the repo.
# Local runs: put the token in .env here, or export DOCSFLOW_MCP_API_KEY in your shell before running.
#
# Bearer token for DocsFlow MCP (or use MCP_TOKEN if you prefer that name).
DOCSFLOW_MCP_API_KEY=
# MCP_TOKEN=
DOCSFLOW_TECH_STACK_VERSION=1-0-1-beta
MCP_SERVER_URL=https://docsflow-mcp.wavemaker.ai/mcp
# Optional: override path map file
# DOCSFLOW_PATH_MAP=/absolute/path/to/path_map.json
